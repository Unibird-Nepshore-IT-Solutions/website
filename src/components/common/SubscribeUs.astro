---
interface Props {
  placeholder: string;
  buttonLabel: string;
  successMessage: string;
  emailErrorMessage: string;
  failedToSaveEmail: string;
}

const {
  placeholder,
  buttonLabel,
  successMessage,
  emailErrorMessage,
  failedToSaveEmail,
} = Astro.props;
---

<form
  data-email-form
  class="w-full max-w-[472px] flex items-center gap-1 h-12 border border-background"
  data-success={successMessage}
  data-error-email={emailErrorMessage}
  data-error-save={failedToSaveEmail}
>
  <div class="h-full min-w-4 w-full">
    <input
      required
      type="email"
      name="email"
      placeholder={placeholder}
      class="p-2 px-3 w-full h-full placeholder:text-base text-black"
    />
  </div>
  <button
    type="submit"
    class="rounded-none px-4 text-nowrap h-full w-auto min-w-28 md:w-44 text-sm md:text-base text-white bg-primary hover:bg-primary-dark font-semibold shadow-lg hover:shadow-primary/30 transition-all duration-300"
  >
    {buttonLabel}
  </button>
</form>

<script src="@/scripts/emailUs.ts"></script>
